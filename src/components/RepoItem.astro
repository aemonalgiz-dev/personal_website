---
import { languageColor, type Repo } from '../lib/github';

interface Props {
  repo: Repo;
  featured?: boolean;
}

const { repo, featured = false } = Astro.props;
const text = repo.blurb ?? repo.description;
const dot = repo.language ? (languageColor[repo.language] ?? 'var(--ink-faint)') : null;

const pushed = new Date(repo.pushedAt).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['repo', { featured }]}>
  <h3>
    <a href={repo.url} target="_blank" rel="noopener">{repo.name}</a>
    {repo.archived && <span class="archived">Archived</span>}
  </h3>

  {text && <p class="repo-text">{text}</p>}

  <p class="meta repo-meta">
    {
      repo.language && (
        <span class="lang">
          <span class="lang-dot" style={`background:${dot}`} aria-hidden="true" />
          {repo.language}
        </span>
      )
    }
    {repo.stars > 0 && <span>★ {repo.stars.toLocaleString('en-US')}</span>}
    {repo.forks > 0 && <span>⑂ {repo.forks.toLocaleString('en-US')}</span>}
    <span>Updated {pushed}</span>
    {
      repo.homepage && (
        <a href={repo.homepage} target="_blank" rel="noopener">
          Site ↗
        </a>
      )
    }
  </p>
</article>

<style>
  .repo {
    padding-block: 1.15rem;
    border-top: 1px solid var(--rule);
  }

  .repo:first-child { border-top: 0; }

  .repo h3 {
    font-size: 1.05rem;
    margin: 0 0 0.3rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .repo.featured h3 { font-size: 1.25rem; }

  .repo h3 a {
    overflow-wrap: anywhere;
    font-family: var(--font-mono-stack);
    font-size: 0.92em;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--accent);
  }

  .repo h3 a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .archived {
    font-family: var(--font-mono-stack);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.1em 0.4em;
  }

  .repo-text {
    margin: 0 0 0.5rem;
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  .repo-meta a { color: inherit; text-decoration: none; }
  .repo-meta a:hover { color: var(--accent-hover); }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lang-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    display: inline-block;
  }
</style>
