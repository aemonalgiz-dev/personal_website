---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---

<Base title="Not found" description="That page does not exist.">
  <div class="notfound prose">
    <p class="label">404</p>
    <h1>That page does not exist</h1>
    <p>
      The link is either wrong or something moved. Here is everything that does
      exist:
    </p>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              target={'external' in item && item.external ? '_blank' : undefined}
              rel={'external' in item && item.external ? 'noopener' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .notfound { padding-block: clamp(1rem, 6vw, 3rem); }
  .notfound .label { margin: 0 0 1rem; }
  .notfound h1 { margin-bottom: 1.25rem; }
  .notfound ul { list-style: none; padding: 0; }
  .notfound li { margin-bottom: 0.5rem; }
</style>
